# =============================================================================
# .env.example  -  AI Hangasszisztens Rendszer
# -----------------------------------------------------------------------------
# M1 (LiveKit-only) mérföldkőhöz szükséges változók.
#
# !!! FIGYELEM - DEV ONLY KULCSOK !!!
# Az alábbi LIVEKIT_API_KEY és LIVEKIT_API_SECRET kizárólag helyi fejlesztésre
# szolgál. Publikus vagy megosztott környezetben azonnal cseréld le a
# `scripts/generate-livekit-keys.sh` által generált (vagy saját) kulcsokra,
# és SOHA ne commit-old a valódi `.env` fájlt.
# =============================================================================

# -----------------------------------------------------------------------------
# Alap konfiguráció
# -----------------------------------------------------------------------------
PROJECT_NAME=ai-assistant-dev
ENVIRONMENT=development
TZ=Europe/Budapest
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LiveKit (M1: csak ezek kellenek)
# -----------------------------------------------------------------------------
# A docker-compose.yml a ${LIVEKIT_API_KEY}:${LIVEKIT_API_SECRET} formátumban
# adja át ezeket a konténernek. A livekit.yaml a `keys:` szekcióban
# ugyanezeket olvassa.

# 24+ karakter hex/base32 szerű azonosító. DEV kulcs, cseréld élesben!
LIVEKIT_API_KEY=APIdevM1localOnlyReplace

# 32+ karakteres titok. DEV kulcs, cseréld élesben!
LIVEKIT_API_SECRET=devsecret_local_only_replace_in_prod_xxxxxxxxxxxxxxxxxx

# Publikus URL, ahogy a kliens (böngésző) eléri a LiveKit szervert.
# M1-ben LAN-on vagyunk: ws:// (nem wss://).
LIVEKIT_URL=ws://localhost:7880

# Belső hosztnév, ahogy a konténerek egymást hívják (compose service name).
LIVEKIT_HOST=livekit
