# ----- Secrets & local config -----
# Never commit the real environment file
.env
.env.local
.env.*.local

# ----- Persistent data & runtime artefacts -----
# These directories are mounted into containers and may grow at runtime
data/sqlite/
data/logs/
data/uploads/
data/livekit/

# ----- Editor / IDE -----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- OS artefacts -----
*~
.cache/

# ----- Local overrides -----
docker-compose.override.yml

# ----- Build / dependency caches -----
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Secrets backups (if any) -----
*.key
*.pem
!certs/.gitkeep

# ----- Trap empty dirs from being deleted silently -----
# (Cargo, Maven, etc. use .gitkeep similarly)
!data/.gitkeep
