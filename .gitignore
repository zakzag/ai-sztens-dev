# compiled output
dist/
build/
coverage/

# Rendered deploy artefacts (generated by deploy/deploy.sh from templates;
# never commit them, they contain the live domain + ACME contact email).
infra/caddy/Caddyfile.rendered

# dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
.nyc_output/

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Real public keys stay local; only placeholders are committed.
*.pub
# Real private keys never belong in the repo.
*.private.key
*.openssh.private
*.openssh.private.key

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
