# compiled output
dist/
build/
coverage/

# Rendered deploy artefacts (generated by deploy/deploy.sh from templates;
# never commit them, they contain the live domain + ACME contact email).
infra/caddy/Caddyfile.rendered

# dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
.nyc_output/

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# dotenv environment variable files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production

# Per-environment overrides (real values, never commit).
# Used by the three-env separation plan (docs/history/2026-10-05--10-30-00-three-env-separation-plan.md):
#   .env.local  → developer machine (local WSL stack)
#   .env.dev    → dev droplet
#   .env.prod   → future prod droplet
apps/**/.env.local
apps/**/.env.dev
apps/**/.env.prod
infra/.env.local
infra/.env.dev
infra/.env.prod
# Whitelist the documented templates so they DO get committed.
!apps/**/.env.example
!infra/.env.example

# Real public keys stay local; only placeholders are committed.
*.pub
# Real private keys never belong in the repo.
*.private.key
*.openssh.private
*.openssh.private.key

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
