# Keep the virtual store path short: matches the length the existing
# node_modules was created with, and shorter paths are safer on Windows
# (MAX_PATH). Do not change without recreating node_modules (`pnpm install`).
virtual-store-dir-max-length=60

# Never let the running pnpm manage (download and record) the package-manager
# version declared by `packageManager` in package.json.
#
# Why: pnpm 12 records that managed version in its *own* YAML document inside
# `pnpm-lock.yaml` (`packageManagerDependencies` + the `@pnpm/exe.*` packages).
# As soon as one pnpm (12, e.g. started by an IDE) has appended that document and
# another (9, on a Node 20 shell) reads the file, the second one aborts with
#
#   ERR_PNPM_BROKEN_LOCKFILE: expected a single document in the stream, but found more
#
# and leaves `node_modules` half-pruned — which then surfaces as
# `Cannot find module '…/node_modules/typescript/bin/tsc'` on the next build.
# Keeping management off keeps the lockfile a single document for every pnpm
# that touches this repository.
manage-package-manager-versions=false
