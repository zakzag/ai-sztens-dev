# ---------------------------------------------------------------------------
# AIsztens — NestJS API configuration.
# This file documents all three environments (local / dev / prod). Copy
# the block you need into the matching per-env file. Real per-env files
# are gitignored and live only on developer machines / the droplet / CI:
#   apps/api/.env.local  → developer machine (local WSL stack)
#   apps/api/.env.dev    → dev droplet
#   apps/api/.env.prod   → future prod droplet (dormant, see notes below)
#
# The active file is selected at boot by `APP_ENV` (see
# `apps/api/src/config/app-env.ts`) and the `envFilePath` array in
# `apps/api/src/app.module.ts:30`. Prod sets `ignoreEnvFile: true`, so
# the prod container NEVER reads a `.env` file even by accident — its
# values come exclusively from the compose `environment:` block.
# ---------------------------------------------------------------------------

# local — used by `pnpm --filter @callback/api start:dev` (i.e. `npm run
# start:dev` from inside `apps/api`).
# `web` and `admin` are the Vite dev servers. Both `localhost` and
# `127.0.0.1` are listed because Chromium and Firefox disagree on which
# one the address bar shows, and CORS compares by exact origin string.
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# dev — used by the dev droplet (APP_ENV=dev). The two real SPA origins
# only; `api.aisztens.hu` is intentionally absent (no SPA runs there).
# CORS_ORIGINS=https://web.aisztens.hu,https://admin.aisztens.hu
# VAPI_WEBHOOK_SECRET=change-me-dev-vapi-secret

# prod — used by the future prod droplet (APP_ENV=prod). The active
# values come from the compose `environment:` block (which reads
# `infra/.env.prod` via `--env-file`); the per-app file is a dormant
# template only. Replace `<prod-domain>` with the real apex when
# provisioning prod.
# CORS_ORIGINS=https://web.<prod-domain>,https://admin.<prod-domain>
# VAPI_WEBHOOK_SECRET=replace-with-strong-unique-prod-secret
