{
  "name": "@callback/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/lib/vite-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:dev": "node ../../scripts/lib/vite-build.mjs --mode dev",
    "dev:prod": "node ../../scripts/lib/vite-build.mjs --mode prod",
    "build": "tsc --noEmit -p tsconfig.json && node ../../scripts/lib/vite-build.mjs build",
    "build:dev": "tsc --noEmit -p tsconfig.json && node ../../scripts/lib/vite-build.mjs build --mode dev",
    "build:prod": "tsc --noEmit -p tsconfig.json && node ../../scripts/lib/vite-build.mjs build --mode prod",
    "preview": "node ../../scripts/lib/vite-build.mjs preview",
    "test": "echo \"@callback/web: no unit tests yet\" && exit 0",
    "lint": "echo \"@callback/web: no eslint config yet\" && exit 0"
  },
  "dependencies": {
    "@callback/shared": "workspace:*",
    "@callback/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
