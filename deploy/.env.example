# ---------------------------------------------------------------------------
# AIsztens — deployment configuration TEMPLATE.
#
# DO NOT edit this file, and do not rename it. Copy it once per deploy target:
#
#   cp deploy/.env.example deploy/.env.dev     # the dev droplet  (default)
#   cp deploy/.env.example deploy/.env.prod    # the prod droplet
#
# deploy.sh picks the file from the target argument:
#
#   ./deploy/deploy.sh up          -> deploy/.env.dev    (default target)
#   ./deploy/deploy.sh up dev      -> deploy/.env.dev
#   ./deploy/deploy.sh up prod     -> deploy/.env.prod
#
# Only `dev` and `prod` are accepted. `local` is NOT a deploy target: the local
# stack is started by scripts/dev-stack.sh, which uses infra/.env.local.
#
# The real per-target files are gitignored (see .gitignore) because they contain
# the droplet address and the absolute path of the SSH private key.
#
# The dev and prod copies normally differ only in the connection values (HOST
# always points at that environment's droplet; SSH_USER/SSH_KEY differ only if
# the droplets authenticate differently). REMOTE_DIR and the bootstrap users are
# usually identical.
# ---------------------------------------------------------------------------

# Droplet public IP or hostname.
HOST=
# Login user for BOTH deploy paths: the local deploy.sh and the GitHub Actions
# workflow both log in as `deployer`, the account created by
# deploy/bootstrap.sh, using the passphrase-less deploy key below.
# `bootstrap` is the ONE command that needs a root login (run it once):
#   SSH_USER=root ./deploy/deploy.sh bootstrap
# The deploy tree (REMOTE_DIR) must be writable by this user; deploy.sh checks
# that before every upload and tells you the fix if it is not.
SSH_USER=deployer

# Path to the SSH private key used for authentication.
# Leave empty to fall back to ssh-agent + ~/.ssh defaults.
# Example: SSH_KEY=./deploy/ssh-keys/deploy.private.key
SSH_KEY=

# Where the repository and runtime config live on the droplet.
REMOTE_DIR=/opt/aisztens

# ---------------------------------------------------------------------------
# GHCR image reference (REQUIRED for deploy.sh up).
#
# The droplet NEVER builds the application images; it only `docker compose pull`
# + `up -d`s pre-built images published by `.github/workflows/images.yml` to
# GitHub Container Registry. deploy.sh appends the three values below to the
# droplet's `infra/.env` on every run, where the base compose
# (`infra/docker-compose.yml`) interpolates them into image references like:
#
#   ${REGISTRY}/${GHCR_OWNER}/aisztens-api:${IMAGE_TAG}
#
# GHCR_OWNER  - GitHub org or user that OWNS the GHCR packages.
#               MUST match the value used by the `images.yml` workflow
#               (its ${{ github.repository_owner }}). If you skip this or set
#               it to the wrong owner, `docker compose pull` will fail with
#               `error from registry: denied` on every application image
#               (postgres and caddy still pull from Docker Hub and are
#               unaffected). Example: GHCR_OWNER=tkovari
IMAGE_TAG=latest
REGISTRY=ghcr.io
# Replace the empty value below with your GitHub org/user before running
# `deploy.sh up` — leaving it blank makes deploy.sh default to `local`, which
# is not a real GHCR owner and the pull will be denied.
GHCR_OWNER=zakzag

# Users managed by bootstrap.sh.
# Sudo-capable users (comma separated). These can administer the machine.
SUDO_USERS=tkovari,krak,deployer
# The user the Node.js app runs on the host (no sudo, but can operate Docker).
APP_USER=aisztens

# Optional: enable UFW during bootstrap (rules: OpenSSH, 80, 443). Keep "0"
# while DigitalOcean's own cloud firewall is active to avoid locking yourself out.
UFW_ENABLE=0

# ---------------------------------------------------------------------------
# Deployment logging (read by deploy/lib/logger.sh, all optional).
#   DEPLOY_LOG_LEVEL=DEBUG   keep log_debug/log_cmd lines (same as --verbose)
#   DEPLOY_LOG_KEEP=<n>      how many finished runs to retain (default 20)
# ---------------------------------------------------------------------------
