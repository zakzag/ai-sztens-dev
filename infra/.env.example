# ---------------------------------------------------------------------------
# AIsztens — runtime stack configuration (template).
#
# This file documents all three environments (local / dev / prod). Copy
# the block you need into the matching per-env file. Real per-env files
# are gitignored and live only on developer machines / the droplet / CI:
#   infra/.env.local  → developer machine (scripts/dev-stack.sh). NOT
#                       shipped to the droplet — dev-stack.sh keeps the
#                       stack off the public internet (Caddy disabled).
#   infra/.env.dev    → the currently running dev droplet (aisztens.hu).
#   infra/.env.prod   → future prod droplet (replace <prod-domain> with
#                       the real apex when provisioning).
#
# The active file is selected at deploy time by `APP_ENV` (see
# `deploy/deploy.sh` and `.github/workflows/deploy.yml`). For the existing
# dev droplet, the deploy script ALSO accepts a legacy `infra/.env` source
# path so the rename is non-breaking on the first run after the cutover.
# ---------------------------------------------------------------------------

# === shared values (every env needs these) ===

# Public domain. Caddy terminates TLS and obtains Let's Encrypt certificates
# for these names. Point DNS A records at the droplet's public IPv4 first.
#   local — `localhost` is fine; the Caddy service is disabled by
#           `infra/docker-compose.local.yml` (profiles: [never]), so this
#           value is unused for TLS purposes.
#   dev   — e.g. `aisztens.hu`.
#   prod  — e.g. `aisztens.com` (or whatever the future prod apex is).
DOMAIN=callback.example.com
# ACME contact email for Let's Encrypt registration.
ACME_EMAIL=ops@example.com

# --- API (NestJS + Fastify) -------------------------------------------------

# Port the API container listens on internally (keep in sync with the
# Dockerfile EXPOSE).
#   local — dev — prod: 3000 (default).
API_PORT=3000

# Comma-separated browser origins allowed to call the API. CORS is
# browser-only; the VAPI webhook is authenticated by an HMAC signature,
# NOT by this list (see `apps/api/src/vapi-webhooks/vapi-signature.guard.ts`).
# Only the SPA origins are included (no apex, no `api.*` — there is no
# browser-originated cross-origin call from those hosts).
#   local — http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
#   dev   — https://web.aisztens.hu,https://admin.aisztens.hu
#   prod  — https://web.<prod-domain>,https://admin.<prod-domain>
CORS_ORIGINS=https://web.example.com,https://admin.example.com

# HMAC-SHA256 key used to authenticate inbound VAPI webhooks. The guard
# rejects any POST /api/vapi/webhooks/* whose `X-Vapi-Signature` header
# does not match `HMAC_SHA256(this_secret, "${X-Vapi-Timestamp}.${rawBody}")`.
# Rotation (works for every env): change this var, then
#   docker compose --env-file infra/.env.<APP_ENV> -f infra/docker-compose.yml up -d --no-build api
# (image rebuild is not required — the value flows in via the environment
# block of the `api` service in `infra/docker-compose.yml`). Until VAPI is
# configured with the new secret, inbound webhooks will fail with 401.
#   local — dev — prod: each env must have its own secret. Never reuse a
#           real prod key in dev or local.
VAPI_WEBHOOK_SECRET=change-me-vapi-secret

# --- PostgreSQL -------------------------------------------------------------

POSTGRES_DB=callback
# Superuser used by the postgres image itself.
POSTGRES_USER=postgres
# Replace per env; the postgres init script derives the role permissions.
#   local — dev — prod: each env must have its own password.
POSTGRES_PASSWORD=change-me-postgres-superuser

# Application runtime user (the `aisztens` OS user maps to this DB role).
AISZTENS_DB_USER=aisztens
# Replace per env.
AISZTENS_DB_PASSWORD=change-me-aisztens-db-password

# Human users who may log in with psql (tkovari and krak).
TKOVARI_DB_PASSWORD=change-me-tkovari-db-password
KRAK_DB_PASSWORD=change-me-krak-db-password

# --- Monitor (watchdog) ------------------------------------------------------

# URL the watchdog polls. `GET /healthz` is the dedicated liveness endpoint
# (see `apps/api/src/health/health.controller.ts`). It is intentionally
# excluded from the NestJS `api` global prefix, so the path is stable even
# when the business routing changes.
MONITOR_TARGET_URL=http://api:3000/healthz
MONITOR_INTERVAL_SECONDS=30
# Optional webhook to POST {"event":"down"|"up","url":...,"status":...,"checked_at":...}
# Examples: Healthchecks.io ping URL, Slack/Discord incoming webhook.
MONITOR_ALERT_WEBHOOK_URL=

# --- Image registry (image-based deploy) -------------------------------------

# Every application service (api, web, admin, monitor) is published as an
# image. The droplet pulls them from this registry; it does not build
# anything itself. The deploy workflow writes IMAGE_TAG and GHCR_OWNER
# here before each `up`.

# Image registry host. Default is GitHub Container Registry.
#   local — ghcr.io (compose override points at the local image names)
#   dev   — ghcr.io
#   prod  — ghcr.io
REGISTRY=ghcr.io

# GitHub org/user that owns the image packages. Used to construct the
# full image reference, e.g. ghcr.io/<GHCR_OWNER>/aisztens-api.
#   local — leave empty; the base compose defaults GHCR_OWNER to
#           `local` and the local override (`docker-compose.local.yml`)
#           replaces the `image:` directive with `aisztens-local/…` so
#           no GHCR pull is attempted.
#   dev   — <github-org> (written by the deploy workflow before every
#           `up`, see `.github/workflows/images.yml`).
#   prod  — <github-org> (typically the same org as the repo).
GHCR_OWNER=

# Exact image tag to run. The deploy workflow writes an immutable
# `sha-<short>` tag (e.g. sha-abcdef0) before each push, so the droplet
# always runs a known revision. The previous sha is the rollback target.
#   local — latest (compose override rebuilds from source anyway)
#   dev   — sha-<short> written by deploy.yml
#   prod  — sha-<short> written by deploy.yml
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Per-env copy snippets (uncomment the block you want, or copy the lines
# manually into your per-env file).
# ---------------------------------------------------------------------------

# infra/.env.local — used by `scripts/dev-stack.sh up`. The script seeds
# this file from `infra/.env.example` on first run.
#   DOMAIN=localhost
#   ACME_EMAIL=dev@localhost
#   CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
#   VAPI_WEBHOOK_SECRET=local-vapi-secret
#   POSTGRES_PASSWORD=local-postgres
#   AISZTENS_DB_PASSWORD=local-aisztens
#   TKOVARI_DB_PASSWORD=local-tkovari
#   KRAK_DB_PASSWORD=local-krak
#   MONITOR_TARGET_URL=http://api:3000/healthz

# infra/.env.dev — the dev droplet (aisztens.hu). Currently lives at
# `/opt/aisztens/infra/.env` on the dev droplet (legacy path), but the
# repo copy should be `infra/.env.dev` going forward.
#   DOMAIN=aisztens.hu
#   ACME_EMAIL=ops@aisztens.hu
#   CORS_ORIGINS=https://web.aisztens.hu,https://admin.aisztens.hu
#   VAPI_WEBHOOK_SECRET=<real dev secret — never commit>
#   POSTGRES_PASSWORD=<real dev password>
#   AISZTENS_DB_PASSWORD=<real dev password>
#   TKOVARI_DB_PASSWORD=<real dev password>
#   KRAK_DB_PASSWORD=<real dev password>

# infra/.env.prod — future prod droplet. Provision <prod-domain> with the
# real apex and generate fresh secrets.
#   DOMAIN=<prod-domain>
#   ACME_EMAIL=ops@<prod-domain>
#   CORS_ORIGINS=https://web.<prod-domain>,https://admin.<prod-domain>
#   VAPI_WEBHOOK_SECRET=<unique prod secret>
#   POSTGRES_PASSWORD=<unique prod password>
#   AISZTENS_DB_PASSWORD=<unique prod password>
#   TKOVARI_DB_PASSWORD=<unique prod password>
#   KRAK_DB_PASSWORD=<unique prod password>