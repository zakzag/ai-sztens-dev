# ---------------------------------------------------------------------------
# Callback Assistant — runtime stack configuration
# Copy to `infra/.env` and fill in real values. Never commit the real file.
# ---------------------------------------------------------------------------

# Public domain. Caddy terminates TLS and obtains Let's Encrypt certificates
# for these names. Point DNS A records at the droplet's public IPv4 first.
DOMAIN=callback.example.com
ACME_EMAIL=ops@example.com

# --- API (NestJS + Fastify) -------------------------------------------------
# Port the API container listens on internally (keep in sync with the Dockerfile EXPOSE).
API_PORT=3000
# Comma-separated browser origins allowed to call the API (production only).
CORS_ORIGINS=https://callback.example.com,https://admin.callback.example.com
# Secret used to authenticate inbound VAPI webhooks (validate in the webhook receiver).
VAPI_WEBHOOK_SECRET=change-me-vapi-secret

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=callback
# Superuser used by the postgres image itself.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser

# Application runtime user (the `aisztens` OS user maps to this DB role).
AISZTENS_DB_USER=aisztens
AISZTENS_DB_PASSWORD=change-me-aisztens-db-password

# Human users who may log in with psql (tkovari and krak).
TKOVARI_DB_PASSWORD=change-me-tkovari-db-password
KRAK_DB_PASSWORD=change-me-krak-db-password

# --- Monitor (watchdog) ------------------------------------------------------
# URL the watchdog polls. `GET /api` is served by the API's root controller.
MONITOR_TARGET_URL=http://api:3000/api
MONITOR_INTERVAL_SECONDS=30
# Optional webhook to POST {"event":"down"|"up","url":...,"status":...,"checked_at":...}
# Examples: Healthchecks.io ping URL, Slack/Discord incoming webhook.
MONITOR_ALERT_WEBHOOK_URL=

# --- Optional static frontends ------------------------------------------------
# Set to the built asset directories if you mount apps/web and apps/admin
# into the Caddy container. Leave empty for the first (API-only) deploy.
WEB_DIST_PATH=../apps/web/dist
ADMIN_DIST_PATH=../apps/admin/dist
