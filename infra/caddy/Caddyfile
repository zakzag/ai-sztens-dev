# AIsztens — reverse proxy + TLS.
#
# This file is a TEMPLATE — the real config used by the running Caddy container
# is `infra/caddy/Caddyfile.rendered`, which `deploy/deploy.sh` regenerates on
# every deploy by substituting the `<DOMAIN>` and `<ACME_EMAIL>` tokens below
# with the values from `infra/.env` (or `deploy/.env`).
#
# Why render server-side instead of relying on Caddy's own placeholders:
#   * `{$DOMAIN}` is the placeholder syntax for blocks defined INSIDE a `{}`
#     block. It is NOT a way to read the process environment.
#   * `{env.DOMAIN}` is supported by some Caddy modules, but NOT in site
#     addresses (the line right after the global options block). The Caddy
#     process literally matches `admin.{env.DOMAIN}` as the host name, then
#     the ACME / Let's Encrypt module rejects it with
#     `subject does not qualify for certificate: 'admin.{env.DOMAIN}'`,
#     causing a restart loop every ~8 s. The `docker logs caddy` output on
#     the droplet makes this very obvious:
#       Error: adapting config using caddyfile: subject does not qualify for
#       certificate: 'admin.{env.DOMAIN}'
#   * Rendering the domain into a plain string at deploy time removes the
#     ambiguity entirely: the rendered Caddyfile contains the literal hostname
#     `admin.aisztens.hu` and Caddy is happy.
#
# Keep the `<DOMAIN>` / `<ACME_EMAIL>` tokens in sync with the `sed` invocation
# in `deploy/deploy.sh:render_caddyfile()`. Anything else in this file
# (e.g. Caddy's own `{path}`, `{uri}` placeholders inside directives) is left
# untouched by the renderer.
#
# M2 (PR #1 of the deploy hardening plan): the token convention used here is
# the single source of truth. Comments in this file MUST keep referring to the
# angle-bracket form (`<DOMAIN>`, `<ACME_EMAIL>`); do NOT switch to the
# `__DOMAIN__` / `__ACME_EMAIL__` style — the renderer only knows the
# angle-bracket form, and a copy-paste mistake would ship a placeholder to
# the Caddy container and trigger the `subject does not qualify` restart loop
# documented in the runbook.

{
	email <ACME_EMAIL>
	admin off
}

# Public API origin. Browser clients and inbound webhooks (e.g. VAPI) use this.
api.<DOMAIN> {
	encode zstd gzip
	reverse_proxy api:3000
}

# Public website (visitor call-back form). Served as a static SPA from
# /srv/web, mounted from apps/web/dist by docker-compose. The `try_files`
# makes deep-link refreshes (e.g. /legal) fall back to /index.html so the
# React Router takes over. Same-origin /api/* is proxied through to the
# NestJS API as a safety net for anyone pasting the API URL under this host.
web.<DOMAIN> {
	encode zstd gzip
	root * /srv/web
	try_files {path} /index.html
	file_server
	handle /api/* {
		reverse_proxy api:3000
	}
}

# Admin dashboard SPA. Same shape as the web site but mounted from
# /srv/admin (apps/admin/dist). In production the SPA calls
# https://api.aisztens.hu/api/... cross-origin; the /api/* handle below
# is only a safety net for same-origin probing.
admin.<DOMAIN> {
	encode zstd gzip
	root * /srv/admin
	try_files {path} /index.html
	file_server
	handle /api/* {
		reverse_proxy api:3000
	}
}

# Apex: redirect to the public website. Until a real landing page is
# mounted at the apex, this is the cleanest behaviour.
<DOMAIN> {
	redir https://web.<DOMAIN>{uri} 307
}
