# Local SonarQube credentials for `pnpm sonar`.
#
# 1. Copy this file to `sonar.env` (same directory, git-ignored).
# 2. Generate a token in SonarQube: My Account → Security → Generate Tokens.
# 3. Fill in SONAR_TOKEN and run `pnpm sonar` from the repo root.
#
# The real process environment always wins over this file, so CI secrets are
# never shadowed by a stale local value.

# Where the (already running) SonarQube server answers.
SONAR_HOST_URL=http://localhost:9000

# User token used by the scanner. Never commit a real token.
SONAR_TOKEN=

# Set to true to make the scan fail when the quality gate is red.
# Useful in CI, usually left off for local runs.
SONAR_QUALITYGATE_WAIT=false
